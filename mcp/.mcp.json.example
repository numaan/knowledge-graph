{
  "mcpServers": {
    "kg": {
      "type": "stdio",
      "command": "/path/to/kg-mcp",
      "env": {
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_USER": "neo4j",
        "NEO4J_PASSWORD": "${NEO4J_PASSWORD}",
        "EMBEDDINGS_URL": "http://localhost:11434",
        "EMBEDDINGS_MODEL": "qwen3-embedding:0.6b",
        "KG_DEFAULT_REPO": "precept"
      }
    },
    "kg-cluster": {
      "type": "http",
      "url": "http://localhost:8000/mcp"
    }
  }
}
